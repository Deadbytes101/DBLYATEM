# Keep POSIX entry points executable by WSL even when the repository is checked
# out by Git for Windows with core.autocrlf enabled.
*.sh text eol=lf

# The deterministic Windows x64 workload hashes repository text bytes directly.
# Keep its generators, manifests, fixtures, and canonical hex byte-stable across
# Git for Windows and POSIX checkouts.
benchmarks/windows-x64-workload/** text eol=lf
